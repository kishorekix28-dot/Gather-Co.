# Copy to .env for local development. Never commit the real .env file.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# PostgreSQL in production, e.g. postgresql://<user>:<password>@<host>:5432/<dbname>
# Leave empty to use local SQLite (db.sqlite3)
DATABASE_URL=
# MongoDB for assistant conversations / messages / feedback, e.g. mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=
MONGODB_DB_NAME=inventory_assistant
# Optional LLM for rephrasing retrieved answers (openai-compatible or anthropic)
AI_API_KEY=
AI_PROVIDER=openai
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Third-party currency API (Frankfurter) – optional overrides
CURRENCY_API_URL=https://api.frankfurter.app/latest
CURRENCY_API_TIMEOUT=5
BASE_CURRENCY=INR
# Admin bootstrap on deploy (python manage.py ensure_admin)
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
# Demo data passwords (python manage.py seed_demo)
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
# Set USE_HTTPS=False only when running DEBUG=False locally without TLS
USE_HTTPS=True
